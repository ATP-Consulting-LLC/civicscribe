# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local mock-mode data
.data/
/test-results/
/playwright-report/
.data-e2e/

# but keep the env templates (no real secrets in these)
!.env.example
!.env.railway.example

# desktop recorder (separate package; never ships with the Next app)
/recorder/dist/
# machine-local recorder config: holds the deployment URL + shared secret
recorder/**/recorder-config.json
# generated preview page and stray electron logs (icon.png/.ico ARE committed)
recorder/build/icon-preview.html
recorder/*.log
